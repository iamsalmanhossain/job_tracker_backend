model AuditLog {
  id          String       @id @default(uuid())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      AuditAction
  entity      AuditEntity
  entityId    String?
  description String?      @db.Text
  ipAddress   String?
  userAgent   String?
  metadata    Json?

  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}
